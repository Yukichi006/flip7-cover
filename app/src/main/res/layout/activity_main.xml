<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/serviceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/openAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ユーザー補助の設定を開く" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/enabledSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="閉じたときにカバー画面へ表示" />

        <!-- 背景 -->
        <TextView
            style="@style/FlipCover.Section"
            android:text="背景" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton android:id="@+id/modeDotClock" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="時計と一体（ドット時計・光の時計）" />
            <RadioButton android:id="@+id/modeDotWave" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="ドットウェーブ" />
            <RadioButton android:id="@+id/modeDotSeconds" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="ドット秒" />
            <RadioButton android:id="@+id/modeLevelMeter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="レベルメーター" />
            <RadioButton android:id="@+id/modeSequencer" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="シーケンサー" />
            <RadioButton android:id="@+id/modeEarth" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="地球（衛星から見た景色）" />
            <RadioButton android:id="@+id/modeMoon" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="月（衛星から見た景色）" />
        </RadioGroup>

        <TextView
            android:id="@+id/speedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/speedSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.25"
            android:valueFrom="0.25"
            android:valueTo="3" />

        <!-- 時計 -->
        <TextView
            style="@style/FlipCover.Section"
            android:text="時計" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/clockSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="時計を表示" />

        <Button
            android:id="@+id/clockStyle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/digitalSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="秒つきデジタル時計も表示" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/backdropSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="時計の後ろをぼかして見やすくする" />

        <!-- ドット系の時計を選んでいるときだけ表示する -->
        <LinearLayout
            android:id="@+id/dotOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/FlipCover.Subsection"
                android:text="背景と一体の時計" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/taperSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="針の先を細くする" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/boldMinuteSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="分針を大きくする" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/minuteTipSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="分針の先に印を付ける" />

            <TextView
                android:id="@+id/glowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/glowSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="1" />
        </LinearLayout>

        <!-- カバー画面のアプリ -->
        <TextView
            style="@style/FlipCover.Section"
            android:text="カバー画面のアプリ" />

        <TextView
            android:id="@+id/appsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

        <Button
            android:id="@+id/pickApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="アプリを選ぶ" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/launcherSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ボタンにまとめる（タップで展開）" />

        <Button
            android:id="@+id/launcherStyle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ウィジェット -->
        <TextView
            style="@style/FlipCover.Section"
            android:text="ウィジェット" />

        <TextView
            android:id="@+id/widgetLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

        <Button
            android:id="@+id/pickWidget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ウィジェットを追加（最大4個）" />

        <Button
            android:id="@+id/removeWidget"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ウィジェットを外す" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/widgetButtonSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ボタンにまとめる（タップで展開）" />

        <Button
            android:id="@+id/widgetButtonStyle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ライト -->
        <TextView
            style="@style/FlipCover.Section"
            android:text="ライト" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/torchSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ライトのスイッチを表示（右へスワイプで点灯、左で消灯）" />

        <!-- プレビュー -->
        <TextView
            style="@style/FlipCover.Section"
            android:text="プレビュー" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ドラッグで移動、2本指で拡大・縮小できます。赤い枠はカメラの位置です。"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/expandedPreviewSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ボタンを開いたときの配置を表示（アプリ・ウィジェット）" />

        <!-- Flip7 のカバー画面 (948x1048) と同じ比率 -->
        <FrameLayout
            android:id="@+id/preview"
            android:layout_width="300dp"
            android:layout_height="332dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="#000000"
            android:clipChildren="true" />

        <Button
            android:id="@+id/resetLayout"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="配置を元に戻す" />

        <TextView
            style="@style/FlipCover.Subsection"
            android:text="ディスプレイ情報（デバッグ用）" />

        <TextView
            android:id="@+id/displayInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
