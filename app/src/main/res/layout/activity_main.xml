<?xml version="1.0" encoding="utf-8"?>
<!--
  設定画面。上に見出し、左にカテゴリの列、右上にカバー画面のプレビュー（常に表示）、
  右下に選んだカテゴリの設定だけを出す。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/serviceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- カテゴリの列 -->
        <ScrollView
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/navRail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="6dp">

            <TextView
                android:id="@+id/navGeneral"
                style="@style/FlipCover.NavItem"
                android:text="全般" />

            <TextView
                android:id="@+id/navBackground"
                style="@style/FlipCover.NavItem"
                android:text="背景" />

            <TextView
                android:id="@+id/navClock"
                style="@style/FlipCover.NavItem"
                android:text="時計" />

            <TextView
                android:id="@+id/navApps"
                style="@style/FlipCover.NavItem"
                android:text="アプリ" />

            <TextView
                android:id="@+id/navWidgets"
                style="@style/FlipCover.NavItem"
                android:text="ウィジェット" />

            <TextView
                android:id="@+id/navBattery"
                style="@style/FlipCover.NavItem"
                android:text="電池" />

            <TextView
                android:id="@+id/navTorch"
                style="@style/FlipCover.NavItem"
                android:text="ライト" />

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="16dp">

            <!-- Flip7 のカバー画面 (948x1048) と同じ比率。ドラッグで移動、2本指で拡大・縮小 -->
            <FrameLayout
                android:id="@+id/preview"
                android:layout_width="260dp"
                android:layout_height="288dp"
                android:layout_gravity="center_horizontal"
                android:background="#000000"
                android:clipChildren="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/expandedPreviewSwitch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="開いた配置を表示"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/resetLayout"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="配置を戻す" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ドラッグで移動、2本指で拡大・縮小。赤い枠はカメラの位置です。"
                android:textSize="11sp" />

            <!-- 選んだカテゴリの設定 -->
            <ScrollView
                android:id="@+id/settingsScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/sectionGeneral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/FlipCover.Section"
                        android:text="全般" />

                    <Button
                        android:id="@+id/openAccessibility"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="ユーザー補助の設定を開く" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/enabledSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="閉じたときにカバー画面へ表示" />


                    <TextView
                        style="@style/FlipCover.Subsection"
                        android:text="ディスプレイ情報（デバッグ用）" />

                    <TextView
                        android:id="@+id/displayInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/FlipCover.Section"
                        android:text="背景" />

                    <RadioGroup
                        android:id="@+id/modeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton android:id="@+id/modeDotClock" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="時計と一体（ドット時計・光の時計）" />
                        <RadioButton android:id="@+id/modeDotWave" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="ドットウェーブ" />
                        <RadioButton android:id="@+id/modeDotSeconds" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="ドット秒" />
                        <RadioButton android:id="@+id/modeLevelMeter" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="レベルメーター" />
                        <RadioButton android:id="@+id/modeSequencer" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="シーケンサー" />
                        <RadioButton android:id="@+id/modeEarth" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="地球（衛星から見た景色）" />
                        <RadioButton android:id="@+id/modeMoon" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="月（衛星から見た景色）" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/speedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/speedSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="0.25"
                        android:valueFrom="0.25"
                        android:valueTo="3" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionClock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/FlipCover.Section"
                        android:text="時計" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/clockSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="時計を表示" />

                    <Button
                        android:id="@+id/clockStyle"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/digitalSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="秒つきデジタル時計も表示" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/backdropSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="時計の後ろをぼかして見やすくする" />

                    <!-- ドット系の時計を選んでいるときだけ表示する -->
                    <LinearLayout
                        android:id="@+id/dotOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FlipCover.Subsection"
                            android:text="背景と一体の時計" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/taperSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="針の先を細くする" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/boldMinuteSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="分針を大きくする" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/minuteTipSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="分針の先に印を付ける" />

                        <TextView
                            android:id="@+id/glowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/glowSlider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="0"
                            android:valueTo="1" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/FlipCover.Section"
                        android:text="カバー画面のアプリ" />

                    <TextView
                        android:id="@+id/appsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/pickApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="アプリを選ぶ" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/launcherSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ボタンにまとめる（タップで展開）" />

                    <Button
                        android:id="@+id/launcherStyle"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionWidgets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/FlipCover.Section"
                        android:text="ウィジェット" />

                    <TextView
                        android:id="@+id/widgetLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/pickWidget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="ウィジェットを追加（最大4個）" />

                    <Button
                        android:id="@+id/removeWidget"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ウィジェットを外す" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/widgetButtonSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ボタンにまとめる（タップで展開）" />

                    <Button
                        android:id="@+id/widgetButtonStyle"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/FlipCover.Section"
                        android:text="電池残量" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/batterySwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="本体と Bluetooth 機器の残量を表示" />

                    <Button
                        android:id="@+id/allowBluetooth"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bluetooth 機器の残量も表示する（許可が必要）" />

                    <Button
                        android:id="@+id/bluetoothDiagnose"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="残量が出ないときは：Bluetooth 機器の診断" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionTorch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/FlipCover.Section"
                        android:text="ライト" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/torchSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ライトのスイッチを表示（右へスワイプで点灯、左で消灯）" />

                </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
