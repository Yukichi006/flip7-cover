<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/serviceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/openAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ユーザー補助の設定を開く" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/enabledSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="閉じたときにカバー画面へ表示" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="アニメーション"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton android:id="@+id/modeEarth" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="地球（宇宙）" />
            <RadioButton android:id="@+id/modeMoon" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="月（宇宙）" />
            <RadioButton android:id="@+id/modeDotSeconds" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="ドット秒（機材風）" />
            <RadioButton android:id="@+id/modeLevelMeter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="レベルメーター（機材風）" />
            <RadioButton android:id="@+id/modeDotWave" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="ドットウェーブ（機材風）" />
            <RadioButton android:id="@+id/modeSequencer" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="シーケンサー（機材風）" />
            <RadioButton android:id="@+id/modeAurora" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="オーロラ（内蔵）" />
            <RadioButton android:id="@+id/modeParticles" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="パーティクル（内蔵）" />
            <RadioButton android:id="@+id/modeGif" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="GIF / アニメーションWebP" />
            <RadioButton android:id="@+id/modeVideo" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="動画（ループ・無音）" />
        </RadioGroup>

        <TextView
            android:id="@+id/mediaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/clockSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="時計を重ねて表示" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/backdropSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="時計の後ろをぼかして見やすくする" />

        <Button
            android:id="@+id/clockStyle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="カバー画面のアプリ"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

        <Button
            android:id="@+id/pickApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="アプリを選ぶ" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="プレビュー"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ドラッグで移動、2本指で拡大・縮小できます。赤い枠はカメラの位置です。"
            android:textSize="12sp" />

        <!-- Flip7 のカバー画面 (948x1048) と同じ比率 -->
        <FrameLayout
            android:id="@+id/preview"
            android:layout_width="300dp"
            android:layout_height="332dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="#000000"
            android:clipChildren="true" />

        <Button
            android:id="@+id/resetLayout"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="配置を元に戻す" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="ディスプレイ情報（デバッグ用）"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/displayInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
