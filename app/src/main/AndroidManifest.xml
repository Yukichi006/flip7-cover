<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 接続中の Bluetooth 機器の電池残量を読む -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- カバー画面に置くアプリを選ぶため、ランチャーに出るアプリの一覧を取得する -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- カバー画面に置けるウィジェットの一覧を取得する -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FlipCover">

        <!-- アイコンから開く画面。閉じている間に開かれたら（Galaxy のルーチンなど）カバー画面の表示を出し、
             開いたメイン画面では、使い方と記録を見せる -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- カバー画面の表示（マス目に並べた時計・アプリ・ウィジェットなど）。ふつうの画面で、重ねて表示・常駐・ユーザー補助は使わない。
             カバー画面で FlipCover を開いたときと、Galaxy のルーチンが「閉じたら FlipCover を開く」を実行したときに出る。
             ロック中でも見られ、カバー画面が消えて点き直しても残る。端末を開くと自分で閉じる -->
        <activity
            android:name=".CoverActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:showWhenLocked="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden" />
    </application>
</manifest>
