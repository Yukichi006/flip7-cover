<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 接続中の Bluetooth 機器の電池残量を読む -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- カバー画面に置くアプリを選ぶため、ランチャーに出るアプリの一覧を取得する -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- カバー画面に置けるウィジェットの一覧を取得する -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FlipCover">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- カバー画面の全画面表示（時計・アプリのボタン・ウィジェット）。カバー画面で FlipCover を開くと、ここに切り替わる。
             ユーザー補助・重ねて表示・常駐などの危ない許可は使わない -->
        <activity
            android:name=".CoverActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:showWhenLocked="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden" />
    </application>
</manifest>
