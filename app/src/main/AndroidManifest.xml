<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 接続中の Bluetooth 機器の電池残量を読む -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- カバー画面に置くアプリを選ぶため、ランチャーに出るアプリの一覧を取得する -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- カバー画面に置けるウィジェットの一覧を取得する -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <!-- 設定画面から、Galaxy の「モードとルーチン」を開く（閉じたら自動で出すルーチンを作ってもらうため） -->
        <package android:name="com.samsung.android.app.routines" />
    </queries>

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FlipCover">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- カバー画面の全画面表示（時計・アプリのボタンなど）。ふつうの画面で、重ねて表示・常駐・ユーザー補助は使わない。
             カバー画面のウィジェットを押したとき、カバー画面で FlipCover を開いたとき、Galaxy のルーチンが
             「閉じたら FlipCover を開く」を実行したときに出る。ロック中でも見られ、カバー画面が消えて点き直しても残る -->
        <activity
            android:name=".CoverActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.yukichi006.flipcover.cover"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:showWhenLocked="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden" />

        <!-- Galaxy のカバー画面に置けるウィジェット（Samsung の公式の仕組み）。時刻を出し、押すと上の全画面表示を開く。
             権限は要らない -->
        <receiver
            android:name=".CoverWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cover_widget" />
            <!-- 「カバー画面用のウィジェット」という Samsung への印 -->
            <meta-data
                android:name="com.samsung.android.appwidget.provider"
                android:resource="@xml/cover_widget_samsung" />
        </receiver>
    </application>
</manifest>
