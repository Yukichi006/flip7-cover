<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 接続中の Bluetooth 機器の電池残量を読む -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 閉じたときに、カバー画面へ表示を重ねる（設定画面で自分で許可したときだけ。ユーザー補助は使わない） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 上の表示のために常駐する（通知欄に目立たない通知が出る） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 電源を入れたときに、常駐を動かし直す -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- カバー画面に置くアプリを選ぶため、ランチャーに出るアプリの一覧を取得する -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- カバー画面に置けるウィジェットの一覧を取得する -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FlipCover">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- カバー画面に表示を重ねる常駐サービス（ユーザー補助は使わない。PayPay などが止まらないように）。
             通知欄に目立たない通知を出して動く -->
        <service
            android:name=".CoverService"
            android:exported="false"
            android:label="@string/service_label"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="端末を閉じたときに、カバー画面へ時計やアプリのボタンを重ねて表示するため" />
        </service>

        <!-- 電源を入れたときと、FlipCover を更新したときに、上の常駐サービスを動かし直す -->
        <receiver
            android:name=".CoverBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
